@model HotelQueue.ViewModels.RoomViewModel

@{
    ViewData["Title"] = "Occupied Rooms";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700&display=swap" rel="stylesheet">

<div class="container-fluid px-4">
    <div class="dashboard-header text-center mb-5">
        <div class="header-content">
            <h1 class="gold-shimmer">Occupied Rooms</h1>
            <p class="text-gold">Currently Booked Accommodations</p>
        </div>
    </div>

    <div class="alert alert-info text-center">
        <i class="fas fa-info-circle me-2"></i>
        These rooms are currently occupied. Please check back later or join our waitlist.
    </div>

    <div class="row g-4">
        @foreach (var room in Model.OccupiedRooms)
        {
            <div class="col-lg-3 col-md-4 col-sm-6">
                <div class="room-card occupied">
                    <div class="room-image" style="background-image: @GetRoomImage(room.Type, room.RoomNumber); opacity: 0.7;">
                        <div class="room-image-overlay">
                            <span class="badge @GetRoomBadge(room.Type)">@room.Type</span>
                        </div>
                        <div class="position-absolute top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center" style="background: rgba(0,0,0,0.5);">
                            <span class="badge bg-danger fs-6">Occupied</span>
                        </div>
                    </div>
                    <div class="room-header">
                        <span class="room-number">Room @room.RoomNumber</span>
                    </div>
                    <div class="room-body">
                        <div class="room-price">₱@GetPriceInPHP(room.PricePerNight).ToString("N0") <small class="text-muted fs-6">/ night</small></div>
                        <div class="room-details">
                            <span><i class="fas fa-user-friends me-1"></i>@room.Capacity guests</span>
                            <span class="text-danger"><i class="fas fa-times me-1"></i>Occupied</span>
                        </div>
                        <hr class="border-secondary my-3">
                        <div class="d-flex justify-content-center">
                            <a asp-controller="Waitlist" asp-action="Create" class="btn btn-warning btn-sm">
                                <i class="fas fa-clock me-1"></i>Join Waitlist
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
        @if (!Model.OccupiedRooms.Any())
        {
            <div class="col-12 text-center py-5">
                <i class="fas fa-check-circle fa-4x mb-3 text-success"></i>
                <h4 class="text-success">All rooms are available!</h4>
                <a asp-controller="Room" asp-action="Available" class="btn btn-primary mt-3">View Available Rooms</a>
            </div>
        }
    </div>

    <div class="text-center mt-5">
        <a asp-controller="Room" asp-action="Index" class="btn btn-outline-primary">
            <i class="fas fa-arrow-left me-2"></i>View All Rooms
        </a>
    </div>
</div>

@functions {
    string GetRoomImage(HotelQueue.Models.RoomType type, string roomNumber)
    {
        string path;
        if (type == HotelQueue.Models.RoomType.Standard)
        {
            path = roomNumber switch
            {
                "101" => "/images/standard-room.jpg",
                "102" => "/images/prado_luxury_hotel_room_standard_family_inner_view.jpg",
                "103" => "/images/RH-12.jpg",
                "104" => "/images/Amorgos-Standard-Room1-e1464286427430.jpg",
                "105" => "/images/images.jpg",
                _ => "/images/standard-room.jpg"
            };
        }
        else if (type == HotelQueue.Models.RoomType.Deluxe)
        {
            path = roomNumber switch
            {
                "201" => "/images/Deluxe/deluxe-room-sea-view.jpg",
                "202" => "/images/Deluxe/istockphoto-1056769738-612x612.jpg",
                "203" => "/images/Deluxe/Mountain-View-Deluxe-King2-788x650.jpg",
                "204" => "/images/Deluxe/Superior-DeLuxe-Room_TB.jpg",
                "205" => "/images/Deluxe/the-phoenician-scottsdale-grand-deluxe-room-01-1200x630.jpg",
                _ => "/images/Deluxe/deluxe-room-sea-view.jpg"
            };
        }
        else if (type == HotelQueue.Models.RoomType.Suite)
        {
            path = roomNumber switch
            {
                "301" => "/images/Suites/5d5b28cf-7701-4173-bf35-a1a8c2e6052a-celebrityhotelsuites_hoteldanieli.jpg",
                "302" => "/images/Suites/caption.jpg",
                "303" => "/images/Suites/premium-deluxe-renaissance.jpg",
                "304" => "/images/Suites/presidential-da-vinci.jpg",
                "305" => "/images/Suites/Royal-Suite-Gioconda-Bedroom-Renaissance-style-819x546.jpg",
                _ => "/images/Suites/5d5b28cf-7701-4173-bf35-a1a8c2e6052a-celebrityhotelsuites_hoteldanieli.jpg"
            };
        }
        else
        {
            return "url('/images/standard-room.jpg')";
        }
        return $"url('{path}')";
    }

    string GetRoomBadge(HotelQueue.Models.RoomType type)
    {
        return type switch
        {
            HotelQueue.Models.RoomType.Standard => "bg-secondary",
            HotelQueue.Models.RoomType.Deluxe => "bg-info",
            HotelQueue.Models.RoomType.Suite => "bg-warning text-dark",
            _ => "bg-secondary"
        };
    }

    decimal GetPriceInPHP(decimal price)
    {
        return price;
    }
}
