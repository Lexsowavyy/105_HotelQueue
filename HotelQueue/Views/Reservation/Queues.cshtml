@model HotelQueue.ViewModels.ReservationQueueViewModel

@{
    ViewData["Title"] = "Queue System";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>
            <i class="fas fa-list-ol text-primary me-2"></i>Queue Processing System
        </h2>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-lg-6">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-danger text-white py-3">
                    <h5 class="mb-0">
                        <i class="fas fa-crown me-2"></i>VIP Priority Queue (Heap)
                    </h5>
                    <small>Priority: VIP Status → Booking Time</small>
                </div>
                <div class="card-body p-0">
                    <div class="queue-stats bg-danger-subtle p-3">
                        <span class="badge bg-danger fs-5">@Model.TotalVIPCount in queue</span>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-danger">
                                <tr>
                                    <th>#</th>
                                    <th>Reservation ID</th>
                                    <th>Customer</th>
                                    <th>Room</th>
                                    <th>Check-In</th>
                                    <th>Priority</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{ int vipCount = 1;}
                                @foreach (var res in Model.VIPQueue)
                                {
                                    <tr>
                                        <td>@vipCount</td>
                                        <td><code>@res.ReservationId</code></td>
                                        <td>@res.Customer?.Name</td>
                                        <td>@res.Room?.RoomNumber</td>
                                        <td>@res.CheckInDate.ToString("MMM dd")</td>
                                        <td><span class="badge bg-danger">@res.Priority</span></td>
                                    </tr>
                                    vipCount++;
                                }
                                @if (!Model.VIPQueue.Any())
                                {
                                    <tr>
                                        <td colspan="6" class="text-center text-muted py-4">
                                            <i class="fas fa-inbox fa-2x mb-2"></i>
                                            <p>VIP queue is empty</p>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-secondary text-white py-3">
                    <h5 class="mb-0">
                        <i class="fas fa-list me-2"></i>Regular Queue (FIFO/FCFS)
                    </h5>
                    <small>Processing: First-Come, First-Served</small>
                </div>
                <div class="card-body p-0">
                    <div class="queue-stats bg-secondary-subtle p-3">
                        <span class="badge bg-secondary fs-5">@Model.TotalRegularCount in queue</span>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-secondary">
                                <tr>
                                    <th>#</th>
                                    <th>Reservation ID</th>
                                    <th>Customer</th>
                                    <th>Room</th>
                                    <th>Check-In</th>
                                    <th>Arrival</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{ int regCount = 1;}
                                @foreach (var res in Model.RegularQueue)
                                {
                                    <tr>
                                        <td>@regCount</td>
                                        <td><code>@res.ReservationId</code></td>
                                        <td>@res.Customer?.Name</td>
                                        <td>@res.Room?.RoomNumber</td>
                                        <td>@res.CheckInDate.ToString("MMM dd")</td>
                                        <td>@res.CreatedAt.ToString("HH:mm:ss")</td>
                                    </tr>
                                    regCount++;
                                }
                                @if (!Model.RegularQueue.Any())
                                {
                                    <tr>
                                        <td colspan="6" class="text-center text-muted py-4">
                                            <i class="fas fa-inbox fa-2x mb-2"></i>
                                            <p>Regular queue is empty</p>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header bg-dark text-white py-3">
                    <h5 class="mb-0"><i class="fas fa-project-diagram me-2"></i>Data Structure Information</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <h6 class="text-danger"><i class="fas fa-crown me-2"></i>VIP Priority Queue (Heap)</h6>
                            <ul class="list-group mb-3">
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    Data Structure
                                    <span class="badge bg-primary">Binary Heap (Max-Heap)</span>
                                </li>
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    Enqueue Operation
                                    <span class="badge bg-success">O(log n)</span>
                                </li>
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    Dequeue Operation
                                    <span class="badge bg-success">O(log n)</span>
                                </li>
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    Peek Operation
                                    <span class="badge bg-success">O(1)</span>
                                </li>
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    Search Operation
                                    <span class="badge bg-warning text-dark">O(n) → O(log n) with index</span>
                                </li>
                            </ul>
                        </div>
                        <div class="col-md-6">
                            <h6 class="text-secondary"><i class="fas fa-list me-2"></i>Regular FIFO Queue</h6>
                            <ul class="list-group mb-3">
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    Data Structure
                                    <span class="badge bg-primary">FIFO Queue</span>
                                </li>
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    Enqueue Operation
                                    <span class="badge bg-success">O(1)</span>
                                </li>
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    Dequeue Operation
                                    <span class="badge bg-success">O(1)</span>
                                </li>
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    Peek Operation
                                    <span class="badge bg-success">O(1)</span>
                                </li>
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    Search Operation
                                    <span class="badge bg-warning text-dark">O(n)</span>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
