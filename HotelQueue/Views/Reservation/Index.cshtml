@model HotelQueue.ViewModels.ReservationViewModel

@{
    ViewData["Title"] = "My Reservations";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var selectedStatus = Context.Request.Query["status"].ToString();
    var selectedDate = Context.Request.Query["date"].ToString();
}

<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700&display=swap" rel="stylesheet">

<style>
    .date-input::-webkit-calendar-picker-indicator,
    input[type="date"]::-webkit-calendar-picker-indicator {
        filter: invert(100%);
        cursor: pointer;
    }
    input[type="date"] {
        background-color: var(--secondary-black);
        color: var(--white);
        border-color: rgba(212, 168, 83, 0.3);
    }
    input[type="date"]::-webkit-inner-spin-button,
    input[type="date"]::-webkit-outer-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }
    .input-group-text {
        background-color: var(--secondary-black);
        border-color: rgba(212, 168, 83, 0.3);
        color: var(--text-light);
    }
</style>
<script>
    function handleReservationDateFilter(select) {
        var customRange = document.getElementById('customDateRangeReservation');
        var applyBtn = document.getElementById('applyBtnReservation');
        if (select.value === 'custom') {
            customRange.style.display = 'flex';
            applyBtn.style.display = 'block';
        } else if (select.value !== '') {
            select.form.submit();
        }
    }
    
    document.addEventListener('DOMContentLoaded', function() {
        var dateFilter = document.querySelector('select[name="dateFilter"]');
        var customRange = document.getElementById('customDateRangeReservation');
        var applyBtn = document.getElementById('applyBtnReservation');
        
        if (dateFilter && customRange && dateFilter.value === 'custom') {
            customRange.style.display = 'flex';
            applyBtn.style.display = 'block';
        }
    });
</script>

<div class="container-fluid px-4">
    <div class="dashboard-header text-center mb-5">
        <div class="header-content">
            <h1 class="gold-shimmer">My Reservations</h1>
            <p class="text-gold">Track and Manage Your Bookings</p>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-3">
            <h5 class="mb-0"><i class="fas fa-list me-2 text-gold"></i>All Bookings</h5>
            <div class="d-flex gap-2 flex-wrap">
                <form method="get" class="d-flex gap-2 flex-wrap" id="filterForm">
                    <select name="status" class="form-select form-select-sm" style="width: auto;" onchange="document.getElementById('filterForm').submit();">
                        <option value="">All Status</option>
                        <option value="Pending" selected="@(selectedStatus == "Pending")">Pending</option>
                        <option value="Confirmed" selected="@(selectedStatus == "Confirmed")">Confirmed</option>
                        <option value="Cancelled" selected="@(selectedStatus == "Cancelled")">Cancelled</option>
                        <option value="Completed" selected="@(selectedStatus == "Completed")">Completed</option>
                        <option value="Expired" selected="@(selectedStatus == "Expired")">Expired</option>
                        <option value="Archived" selected="@(selectedStatus == "Archived")">Archived</option>
                        <option value="OnWaitlist" selected="@(selectedStatus == "OnWaitlist")">On Waitlist</option>
                    </select>
                    <select name="dateFilter" class="form-select form-select-sm" style="width: 130px;" onchange="handleReservationDateFilter(this)">
                        @{
                            var dateFilter = Context.Request.Query["dateFilter"].ToString();
                            var hasCustomDate = !string.IsNullOrEmpty(Context.Request.Query["startDate"].ToString());
                            var searchQuery = Context.Request.Query["search"].ToString();
                        }
                        <option value="">All Time</option>
                        <option value="today" selected="@(dateFilter == "today")">Today</option>
                        <option value="week" selected="@(dateFilter == "week")">This Week</option>
                        <option value="month" selected="@(dateFilter == "month")">This Month</option>
                        <option value="year" selected="@(dateFilter == "year")">This Year</option>
                        <option value="custom" selected="@hasCustomDate">Custom Range</option>
                    </select>
                    <div class="input-group input-group-sm" id="customDateRangeReservation" style="display: none;">
                        <input type="date" name="startDate" class="form-control" value="@Context.Request.Query["startDate"].ToString()" />
                        <span class="input-group-text">to</span>
                        <input type="date" name="endDate" class="form-control" value="@Context.Request.Query["endDate"].ToString()" />
                    </div>
                    <div class="input-group input-group-sm" style="width: 180px;">
                        <span class="input-group-text"><i class="fas fa-search"></i></span>
                        <input type="text" name="search" class="form-control" placeholder="Search..." value="@searchQuery" />
                    </div>
                    @if (!string.IsNullOrEmpty(selectedStatus) || !string.IsNullOrEmpty(dateFilter) || hasCustomDate)
                    {
                        <a asp-controller="Reservation" asp-action="Index" class="btn btn-outline-secondary btn-sm">
                            <i class="fas fa-times me-1"></i>Clear
                        </a>
                    }
                    <button type="submit" id="applyBtnReservation" class="btn btn-primary btn-sm" style="display: none;">
                        <i class="fas fa-filter"></i>
                    </button>
                </form>
                <a asp-controller="Reservation" asp-action="Create" class="btn btn-primary btn-sm">
                    <i class="fas fa-plus me-1"></i>New Booking
                </a>
            </div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table mb-0">
                    <thead>
                        <tr>
                            <th>Booking ID</th>
                            <th>Guest Name</th>
                            <th>Room</th>
                            <th>Check-In</th>
                            <th>Check-Out</th>
                            <th>Status</th>
                            <th>Type</th>
                            <th>Total</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var res in Model.AllReservations)
                        {
                            <tr>
                                <td><code>@res.ReservationId</code></td>
                                <td>@res.Customer?.Name</td>
                                <td>@res.Room?.RoomNumber</td>
                                <td>@res.CheckInDate.ToString("MMM dd, yyyy HH:mm")</td>
                                <td>@res.CheckOutDate.ToString("MMM dd, yyyy HH:mm")</td>
                                <td>
                                    <span class="badge @GetStatusBadgeClass(res.Status)">@res.Status</span>
                                </td>
                                <td>
                                    @if (res.CustomerType == CustomerType.VIP)
                                    {
                                        <span class="badge bg-warning text-dark"><i class="fas fa-crown me-1"></i>VIP</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Regular</span>
                                    }
                                </td>
                                <td class="text-gold fw-bold">₱@GetPriceInPHP(res.TotalPrice).ToString("N2")</td>
                                <td>
                                    <div class="btn-group btn-group-sm">
                                        <a asp-controller="Reservation" asp-action="Details" asp-route-id="@res.ReservationId" 
                                           class="btn btn-outline-primary" title="View">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        @if (res.Status != ReservationStatus.Archived && res.Status != ReservationStatus.Completed)
                                        {
                                            <a asp-controller="Reservation" asp-action="Edit" asp-route-id="@res.ReservationId" 
                                               class="btn btn-outline-warning" title="Edit">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                        }
                                        @if (res.Status != ReservationStatus.Archived)
                                        {
                                            <form asp-controller="Reservation" asp-action="Archive" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@res.ReservationId" />
                                                <button type="submit" class="btn btn-outline-secondary" title="Archive" onclick="return confirm('Are you sure you want to archive this reservation?')">
                                                    <i class="fas fa-archive"></i>
                                                </button>
                                            </form>
                                        }
                                        @if (res.Status == ReservationStatus.Pending)
                                        {
                                            <form asp-controller="Reservation" asp-action="Confirm" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@res.ReservationId" />
                                                <button type="submit" class="btn btn-outline-success" title="Confirm">
                                                    <i class="fas fa-check"></i>
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                        @if (!Model.AllReservations.Any())
                        {
                            <tr>
                                <td colspan="9" class="text-center py-5">
                                    <i class="fas fa-calendar-times fa-4x mb-3 text-muted opacity-25"></i>
                                    <h5 class="text-muted">No reservations found</h5>
                                    <a asp-controller="Reservation" asp-action="Create" class="btn btn-primary mt-3">Make Your First Booking</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@functions {
    string GetStatusBadgeClass(HotelQueue.Models.ReservationStatus status)
    {
        return status switch
        {
            HotelQueue.Models.ReservationStatus.Pending => "bg-warning text-dark",
            HotelQueue.Models.ReservationStatus.Confirmed => "bg-success",
            HotelQueue.Models.ReservationStatus.Cancelled => "bg-danger",
            HotelQueue.Models.ReservationStatus.Expired => "bg-secondary",
            HotelQueue.Models.ReservationStatus.Completed => "bg-info",
            HotelQueue.Models.ReservationStatus.OnWaitlist => "bg-info text-dark",
            HotelQueue.Models.ReservationStatus.Archived => "bg-dark",
            _ => "bg-secondary"
        };
    }

    decimal GetPriceInPHP(decimal priceInUSD)
    {
        decimal exchangeRate = 56.00m;
        return priceInUSD * exchangeRate;
    }
}
