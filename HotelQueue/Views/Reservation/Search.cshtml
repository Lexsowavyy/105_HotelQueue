@model HotelQueue.ViewModels.ReservationSearchViewModel

@{
    ViewData["Title"] = "Search Reservations";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>
            <i class="fas fa-search text-primary me-2"></i>Search Reservations
        </h2>
        <a asp-controller="Reservation" asp-action="Index" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-1"></i>Back
        </a>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form asp-controller="Reservation" asp-action="Search" method="get" class="row g-3">
                <div class="col-md-10">
                    <div class="input-group">
                        <span class="input-group-text"><i class="fas fa-search"></i></span>
                        <input type="text" name="searchTerm" class="form-control" 
                               placeholder="Search by ID, customer name, email, or room number..." 
                               value="@Model.SearchTerm" />
                    </div>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="fas fa-search me-1"></i>Search
                    </button>
                </div>
            </form>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.SearchTerm))
    {
        <div class="card shadow-sm">
            <div class="card-header bg-white py-3">
                <h5 class="mb-0">
                    Search Results for "<strong>@Model.SearchTerm</strong>"
                    <span class="badge bg-primary ms-2">@Model.Results.Count found</span>
                </h5>
            </div>
            <div class="card-body p-0">
                @if (Model.Results.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-primary">
                                <tr>
                                    <th>Reservation ID</th>
                                    <th>Customer</th>
                                    <th>Room</th>
                                    <th>Check-In</th>
                                    <th>Check-Out</th>
                                    <th>Status</th>
                                    <th>Type</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var res in Model.Results)
                                {
                                    <tr>
                                        <td><code>@res.ReservationId</code></td>
                                        <td>
                                            <div>@res.Customer?.Name</div>
                                            <small class="text-muted">@res.Customer?.Email</small>
                                        </td>
                                        <td>@res.Room?.RoomNumber</td>
                                        <td>@res.CheckInDate.ToString("MMM dd, yyyy")</td>
                                        <td>@res.CheckOutDate.ToString("MMM dd, yyyy")</td>
                                        <td>
                                            <span class="badge @GetStatusBadgeClass(res.Status)">@res.Status</span>
                                        </td>
                                        <td>
                                            @if (res.CustomerType == CustomerType.VIP)
                                            {
                                                <span class="badge bg-danger"><i class="fas fa-crown me-1"></i>VIP</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">Regular</span>
                                            }
                                        </td>
                                        <td>
                                            <a asp-controller="Reservation" asp-action="Details" asp-route-id="@res.ReservationId" 
                                               class="btn btn-sm btn-outline-primary">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-5">
                        <i class="fas fa-search fa-3x text-muted mb-3"></i>
                        <h5 class="text-muted">No reservations found</h5>
                        <p class="text-muted">Try a different search term</p>
                    </div>
                }
            </div>
        </div>
    }
</div>

@functions {
    string GetStatusBadgeClass(HotelQueue.Models.ReservationStatus status)
    {
        return status switch
        {
            HotelQueue.Models.ReservationStatus.Pending => "bg-warning text-dark",
            HotelQueue.Models.ReservationStatus.Confirmed => "bg-success",
            HotelQueue.Models.ReservationStatus.Cancelled => "bg-danger",
            HotelQueue.Models.ReservationStatus.Expired => "bg-secondary",
            HotelQueue.Models.ReservationStatus.Completed => "bg-info",
            _ => "bg-secondary"
        };
    }
}
