@model HotelQueue.ViewModels.CreateReservationViewModel

@{
    ViewData["Title"] = "Edit Reservation";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700&display=swap" rel="stylesheet">

<style>
    .datetime-input {
        background-color: #ffffff !important;
        color: #000 !important;
        border: 1px solid #ced4da;
    }
    .datetime-input::-webkit-calendar-picker-indicator {
        filter: invert(0%);
        cursor: pointer;
    }
</style>

<div class="container">
    <form asp-controller="Reservation" asp-action="Edit" method="post">
        @Html.AntiForgeryToken()
        
        <div class="row">
            <div class="col-lg-8">
                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="mb-0"><i class="fas fa-user me-2 text-gold"></i>Guest Information</h5>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="CustomerName" class="form-label">Full Name</label>
                                <input asp-for="CustomerName" class="form-control" required placeholder="Juan dela Cruz" />
                                <span asp-validation-for="CustomerName" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="CustomerEmail" class="form-label">Email Address</label>
                                <input asp-for="CustomerEmail" type="email" class="form-control" required placeholder="juan@email.com" />
                                <span asp-validation-for="CustomerEmail" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="CustomerPhone" class="form-label">Phone Number</label>
                                <input asp-for="CustomerPhone" class="form-control" required placeholder="0912-345-6789" />
                                <span asp-validation-for="CustomerPhone" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="CustomerType" class="form-label">Membership Type</label>
                                <select asp-for="CustomerType" class="form-select">
                                    <option value="@CustomerType.Regular">Regular Guest</option>
                                    <option value="@CustomerType.VIP">VIP Member (Priority Queue)</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="mb-0"><i class="fas fa-bed me-2 text-gold"></i>Room Selection</h5>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label asp-for="RoomId" class="form-label">Select Room</label>
                            <select asp-for="RoomId" class="form-select" id="roomSelect" required onchange="updateRoomImage();">
                                <option value="">-- Choose a Room --</option>
                                <optgroup label="Available Rooms">
                                    @foreach (var room in Model.AllRooms.Where(r => r.IsAvailable))
                                    {
                                        <option value="@room.RoomId" data-type="@room.Type" data-roomnumber="@room.RoomNumber" data-image="@GetRoomImageUrl(room.Type, room.RoomNumber)" data-available="true">
                                            Room @room.RoomNumber - @room.Type (₱@GetPriceInPHP(room.PricePerNight).ToString("N0")/night) - @room.Capacity guests [Available]
                                        </option>
                                    }
                                </optgroup>
                                <optgroup label="Occupied Rooms">
                                    @foreach (var room in Model.AllRooms.Where(r => !r.IsAvailable))
                                    {
                                        <option value="@room.RoomId" data-type="@room.Type" data-roomnumber="@room.RoomNumber" data-image="@GetRoomImageUrl(room.Type, room.RoomNumber)" data-available="false">
                                            Room @room.RoomNumber - @room.Type (₱@GetPriceInPHP(room.PricePerNight).ToString("N0")/night) - @room.Capacity guests [Occupied]
                                        </option>
                                    }
                                </optgroup>
                            </select>
                            <span asp-validation-for="RoomId" class="text-danger"></span>
                        </div>
                        <div id="roomImageContainer" class="text-center mt-3" style="display: none;">
                            <img id="roomImage" src="" alt="Room Image" class="img-fluid rounded" style="max-height: 200px; object-fit: cover;" />
                        </div>
                    </div>
                </div>

                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="mb-0"><i class="fas fa-calendar me-2 text-gold"></i>Stay Details</h5>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="CheckInDate" class="form-label">Check-In Date & Time</label>
                                <input asp-for="CheckInDate" type="datetime-local" class="form-control datetime-input" required />
                                <span asp-validation-for="CheckInDate" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="CheckOutDate" class="form-label">Check-Out Date & Time</label>
                                <input asp-for="CheckOutDate" type="datetime-local" class="form-control datetime-input" required />
                                <span asp-validation-for="CheckOutDate" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="d-grid gap-2">
                    <button type="submit" class="btn btn-warning btn-lg">
                        <i class="fas fa-save me-2"></i>Update Reservation
                    </button>
                    <a asp-controller="Reservation" asp-action="Index" class="btn btn-outline-secondary">
                        <i class="fas fa-arrow-left me-2"></i>Back to Reservations
                    </a>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card sticky-top" style="top: 100px;">
                    <div class="card-header">
                        <h5 class="mb-0 text-center"><i class="fas fa-info-circle me-2 text-gold"></i>Edit Information</h5>
                    </div>
                    <div class="card-body">
                        <div class="mb-4">
                            <h6 class="text-gold"><i class="fas fa-edit me-2"></i>Update Details</h6>
                            <p class="text-muted small">Modify the guest information, room selection, or stay dates as needed.</p>
                        </div>
                        <hr class="border-secondary">
                        <div class="mb-4">
                            <h6 class="text-gold"><i class="fas fa-crown me-2"></i>VIP Membership</h6>
                            <p class="text-muted small">VIP members get priority in the queue for room availability.</p>
                        </div>
                        <hr class="border-secondary">
                        <div class="text-center">
                            <i class="fas fa-shield-alt fa-2x text-gold mb-2"></i>
                            <p class="text-muted small mb-0">Changes will be saved immediately</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        document.querySelector('form').addEventListener('submit', function(e) {
            var checkInValue = document.getElementById('CheckInDate').value;
            var checkOutValue = document.getElementById('CheckOutDate').value;
            
            if (!checkInValue || !checkOutValue) {
                return;
            }
            
            var checkIn = new Date(checkInValue);
            var checkOut = new Date(checkOutValue);
            
            if (checkOut <= checkIn) {
                e.preventDefault();
                alert('Check-out date must be after check-in date.');
            }
        });

        function updateRoomImage() {
            var select = document.getElementById('roomSelect');
            var selectedOption = select.options[select.selectedIndex];
            var imageContainer = document.getElementById('roomImageContainer');
            var roomImage = document.getElementById('roomImage');
            
            if (selectedOption.value) {
                var imageUrl = selectedOption.getAttribute('data-image');
                roomImage.src = imageUrl;
                imageContainer.style.display = 'block';
            } else {
                imageContainer.style.display = 'none';
            }
        }

        document.getElementById('roomSelect').addEventListener('change', updateRoomImage);
        window.addEventListener('load', updateRoomImage);
    </script>
}

@functions {
    decimal GetPriceInPHP(decimal priceInUSD)
    {
        decimal exchangeRate = 56.00m;
        return priceInUSD * exchangeRate;
    }

    string GetRoomImageUrl(HotelQueue.Models.RoomType type, string roomNumber)
    {
        if (type == HotelQueue.Models.RoomType.Standard)
        {
            return roomNumber switch
            {
                "101" => "/images/standard-room.jpg",
                "102" => "/images/prado_luxury_hotel_room_standard_family_inner_view.jpg",
                "103" => "/images/RH-12.jpg",
                "104" => "/images/Amorgos-Standard-Room1-e1464286427430.jpg",
                "105" => "/images/images.jpg",
                _ => "/images/standard-room.jpg"
            };
        }
        else if (type == HotelQueue.Models.RoomType.Deluxe)
        {
            return roomNumber switch
            {
                "201" => "/images/Deluxe/deluxe-room-sea-view.jpg",
                "202" => "/images/Deluxe/istockphoto-1056769738-612x612.jpg",
                "203" => "/images/Deluxe/Mountain-View-Deluxe-King2-788x650.jpg",
                "204" => "/images/Deluxe/Superior-DeLuxe-Room_TB.jpg",
                "205" => "/images/Deluxe/the-phoenician-scottsdale-grand-deluxe-room-01-1200x630.jpg",
                _ => "/images/Deluxe/deluxe-room-sea-view.jpg"
            };
        }
        else if (type == HotelQueue.Models.RoomType.Suite)
        {
            return roomNumber switch
            {
                "301" => "/images/Suites/5d5b28cf-7701-4173-bf35-a1a8c2e6052a-celebrityhotelsuites_hoteldanieli.jpg",
                "302" => "/images/Suites/caption.jpg",
                "303" => "/images/Suites/premium-deluxe-renaissance.jpg",
                "304" => "/images/Suites/presidential-da-vinci.jpg",
                "305" => "/images/Suites/Royal-Suite-Gioconda-Bedroom-Renaissance-style-819x546.jpg",
                _ => "/images/Suites/5d5b28cf-7701-4173-bf35-a1a8c2e6052a-celebrityhotelsuites_hoteldanieli.jpg"
            };
        }
        return "/images/standard-room.jpg";
    }
}
