@model HotelQueue.ViewModels.NotificationViewModel

@{
    ViewData["Title"] = "Notifications by Type";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>
            <i class="fas fa-filter text-warning me-2"></i>Notifications by Type
        </h2>
        <a asp-controller="Notification" asp-action="Index" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-1"></i>Back to All
        </a>
    </div>

    <div class="row mb-4">
        <div class="col-12">
            <div class="btn-group" role="group">
                <a asp-controller="Notification" asp-action="ByType" asp-route-type="Confirmation" class="btn btn-outline-success">
                    <i class="fas fa-check-circle me-1"></i>Confirmations
                </a>
                <a asp-controller="Notification" asp-action="ByType" asp-route-type="Cancellation" class="btn btn-outline-danger">
                    <i class="fas fa-times-circle me-1"></i>Cancellations
                </a>
                <a asp-controller="Notification" asp-action="ByType" asp-route-type="WaitlistPromotion" class="btn btn-outline-warning">
                    <i class="fas fa-arrow-up me-1"></i>Promotions
                </a>
                <a asp-controller="Notification" asp-action="ByType" asp-route-type="Reminder" class="btn btn-outline-info">
                    <i class="fas fa-bell me-1"></i>Reminders
                </a>
                <a asp-controller="Notification" asp-action="ByType" asp-route-type="Expiration" class="btn btn-outline-secondary">
                    <i class="fas fa-clock me-1"></i>Expirations
                </a>
            </div>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body p-0">
            @foreach (var notif in Model.AllNotifications)
            {
                <div class="notification-item @(notif.IsRead ? "" : "unread")">
                    <div class="row align-items-center">
                        <div class="col-auto">
                            <div class="notification-icon @GetIconClass(notif.Type)">
                                <i class="@GetIcon(notif.Type)"></i>
                            </div>
                        </div>
                                <div class="col">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <h6 class="mb-1">@GetTitle(notif.Type)</h6>
                                    <p class="mb-1">@notif.Message</p>
                                    <small class="text-muted">@notif.CreatedAt.ToString("g")</small>
                                </div>
                                <div class="d-flex align-items-center">
                                    @if (!notif.IsRead)
                                    {
                                        <span class="badge bg-danger me-2">New</span>
                                    }
                                    @if (notif.Type == HotelQueue.Models.NotificationType.Archive)
                                    {
                                        <a asp-controller="Reservation" asp-action="Details" asp-route-id="@notif.ReservationId" class="btn btn-sm btn-outline-primary me-1" title="View">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        <form asp-controller="Reservation" asp-action="Restore" method="post" class="d-inline me-1">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@notif.ReservationId" />
                                            <button type="submit" class="btn btn-sm btn-outline-success" title="Restore" onclick="return confirm('Are you sure you want to restore this reservation?')">
                                                <i class="fas fa-undo"></i>
                                            </button>
                                        </form>
                                        <form asp-controller="Notification" asp-action="Delete" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@notif.NotificationId" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete" onclick="return confirm('Are you sure you want to delete this notification?')">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form asp-controller="Notification" asp-action="MarkAsRead" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@notif.NotificationId" />
                                            <button type="submit" class="btn btn-sm btn-outline-secondary" title="Mark as read">
                                                <i class="fas fa-check"></i>
                                            </button>
                                        </form>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
            @if (!Model.AllNotifications.Any())
            {
                <div class="text-center py-5">
                    <i class="fas fa-inbox fa-4x text-muted mb-3"></i>
                    <h5 class="text-muted">No notifications found</h5>
                    <a asp-controller="Notification" asp-action="Index" class="btn btn-primary mt-3">
                        <i class="fas fa-inbox me-1"></i>View All Notifications
                    </a>
                </div>
            }
        </div>
    </div>
</div>

@functions {
    string GetIcon(HotelQueue.Models.NotificationType type)
    {
        return type switch
        {
            HotelQueue.Models.NotificationType.Confirmation => "fas fa-check",
            HotelQueue.Models.NotificationType.Cancellation => "fas fa-times",
            HotelQueue.Models.NotificationType.WaitlistPromotion => "fas fa-arrow-up",
            HotelQueue.Models.NotificationType.Reminder => "fas fa-bell",
            HotelQueue.Models.NotificationType.Expiration => "fas fa-clock",
            HotelQueue.Models.NotificationType.Archive => "fas fa-archive",
            _ => "fas fa-info"
        };
    }

    string GetIconClass(HotelQueue.Models.NotificationType type)
    {
        return type switch
        {
            HotelQueue.Models.NotificationType.Confirmation => "bg-success text-white",
            HotelQueue.Models.NotificationType.Cancellation => "bg-danger text-white",
            HotelQueue.Models.NotificationType.WaitlistPromotion => "bg-warning text-dark",
            HotelQueue.Models.NotificationType.Reminder => "bg-info text-white",
            HotelQueue.Models.NotificationType.Expiration => "bg-secondary text-white",
            HotelQueue.Models.NotificationType.Archive => "bg-dark text-white",
            _ => "bg-primary text-white"
        };
    }

    string GetTitle(HotelQueue.Models.NotificationType type)
    {
        return type switch
        {
            HotelQueue.Models.NotificationType.Confirmation => "Reservation Confirmed",
            HotelQueue.Models.NotificationType.Cancellation => "Reservation Cancelled",
            HotelQueue.Models.NotificationType.WaitlistPromotion => "Waitlist Promotion",
            HotelQueue.Models.NotificationType.Reminder => "Reminder",
            HotelQueue.Models.NotificationType.Expiration => "Reservation Expired",
            HotelQueue.Models.NotificationType.Archive => "Reservation Archived",
            _ => "Notification"
        };
    }
}
