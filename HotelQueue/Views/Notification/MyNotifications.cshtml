@model HotelQueue.ViewModels.NotificationViewModel

@{
    ViewData["Title"] = "My Notifications";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid px-4">
    <div class="dashboard-header text-center mb-5">
        <div class="header-content">
            <h1 class="gold-shimmer">My Notifications</h1>
            <p class="text-gold">Stay updated with your bookings</p>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card stat-card">
                <div class="card-body text-center">
                    <i class="fas fa-bell fa-2x text-gold mb-2"></i>
                    <h3 class="mb-1">@Model.AllNotifications.Count</h3>
                    <p class="mb-0 text-muted">Total</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card stat-card">
                <div class="card-body text-center">
                    <i class="fas fa-envelope-open fa-2x text-success mb-2"></i>
                    <h3 class="mb-1">@Model.AllNotifications.Count(n => n.IsRead)</h3>
                    <p class="mb-0 text-muted">Read</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card stat-card">
                <div class="card-body text-center">
                    <i class="fas fa-envelope fa-2x text-warning mb-2"></i>
                    <h3 class="mb-1">@Model.UnreadCount</h3>
                    <p class="mb-0 text-muted">Unread</p>
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="mb-0"><i class="fas fa-list me-2 text-gold"></i>All Notifications</h5>
            @if (Model.UnreadCount > 0)
            {
                <a asp-controller="Notification" asp-action="MarkAllAsRead" class="btn btn-outline-primary btn-sm">
                    <i class="fas fa-check-double me-1"></i>Mark All as Read
                </a>
            }
        </div>
        <div class="card-body p-0">
            <div class="notification-list">
                @foreach (var notification in Model.AllNotifications)
                {
                    <div class="notification-item @(notification.IsRead ? "read" : "unread")">
                        <div class="d-flex align-items-center p-3">
                            <div class="notification-icon me-3">
                                @switch (notification.Type)
                                {
                                    case NotificationType.Confirmation:
                                        <span class="icon-circle bg-success"><i class="fas fa-check text-white"></i></span>
                                        break;
                                    case NotificationType.Cancellation:
                                        <span class="icon-circle bg-danger"><i class="fas fa-times text-white"></i></span>
                                        break;
                                    case NotificationType.WaitlistPromotion:
                                        <span class="icon-circle bg-warning"><i class="fas fa-arrow-up text-white"></i></span>
                                        break;
                                    case NotificationType.Expiration:
                                        <span class="icon-circle bg-secondary"><i class="fas fa-clock text-white"></i></span>
                                        break;
                                    case NotificationType.Reminder:
                                        <span class="icon-circle bg-info"><i class="fas fa-bell text-white"></i></span>
                                        break;
                                    default:
                                        <span class="icon-circle bg-primary"><i class="fas fa-info text-white"></i></span>
                                        break;
                                }
                            </div>
                            <div class="notification-content flex-grow-1">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div>
                                        <h6 class="mb-1">@GetNotificationTitle(notification.Type)</h6>
                                        <p class="mb-1 text-muted">@notification.Message</p>
                                        @if (!string.IsNullOrEmpty(notification.ReservationId))
                                        {
                                            <small class="text-gold">Reservation: @notification.ReservationId</small>
                                        }
                                    </div>
                                    <small class="text-muted">@notification.CreatedAt.ToString("MMM dd, yyyy HH:mm")</small>
                                </div>
                            </div>
                            <div class="notification-actions ms-3">
                                @if (!notification.IsRead)
                                {
                                    <form asp-controller="Notification" asp-action="MarkAsRead" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@notification.NotificationId" />
                                        <button type="submit" class="btn btn-outline-success btn-sm" title="Mark as Read">
                                            <i class="fas fa-check"></i>
                                        </button>
                                    </form>
                                }
                                <a asp-controller="Notification" asp-action="Details" asp-route-id="@notification.NotificationId" 
                                   class="btn btn-outline-primary btn-sm" title="View Details">
                                    <i class="fas fa-eye"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                }
                @if (!Model.AllNotifications.Any())
                {
                    <div class="text-center py-5">
                        <i class="fas fa-bell-slash fa-4x mb-3 text-muted opacity-25"></i>
                        <h5 class="text-muted">No notifications yet</h5>
                        <p class="text-muted">You'll receive updates about your bookings here.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<style>
    .notification-item {
        border-bottom: 1px solid rgba(255,255,255,0.05);
    }
    .notification-item:last-child {
        border-bottom: none;
    }
    .notification-item.unread {
        background: rgba(212, 168, 83, 0.1);
    }
    .notification-item.unread .notification-content h6 {
        color: #d4a853;
    }
    .icon-circle {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
    }
</style>

@functions {
    string GetNotificationTitle(NotificationType type)
    {
        return type switch
        {
            NotificationType.Confirmation => "Booking Confirmed",
            NotificationType.Cancellation => "Booking Cancelled",
            NotificationType.WaitlistPromotion => "Waitlist Promotion",
            NotificationType.Expiration => "Booking Expired",
            NotificationType.Reminder => "Booking Reminder",
            _ => "Notification"
        };
    }
}
